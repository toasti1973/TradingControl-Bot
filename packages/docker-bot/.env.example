# TradingControl Bot — Konfiguration

# TradingControl API
TC_API_URL=https://tradingcontrol.example.com
TC_API_KEY=tc_bot_your_api_key_here

# Broker: paper | phemex
BROKER_TYPE=paper

# Phemex (nur wenn BROKER_TYPE=phemex)
PHEMEX_API_KEY=
PHEMEX_API_SECRET=
PHEMEX_TESTNET=true

# Web UI
WEB_UI_PASSWORD=changeme
WEB_PORT=3000

# Polling-Intervalle (ms)
PLAN_POLL_INTERVAL=30000
PRICE_POLL_INTERVAL=2000
ORDER_CHECK_INTERVAL=3000

# Logging: trace | debug | info | warn | error
LOG_LEVEL=info

# Datenverzeichnis
DATA_DIR=./data
