# ============================================================
# TradingControl Bot — Konfiguration
#
# Diese Datei als `.env` kopieren und ausfuellen. Zugangsdaten lassen
# sich stattdessen auch ueber die Weboberflaeche des Bots eintragen;
# sie liegen dann verschluesselt in `data/keys.enc` statt im Klartext.
# ============================================================

# ── Anbindung an das Journal (optional) ─────────────────────────────────
#
# Ohne diese Angaben laeuft der Bot mit seinen eigenen Plaenen weiter.
# Die Verbindung ist eine Einbahnstrasse: Der Bot liest Handelsplaene,
# er meldet nichts zurueck. Was an der Boerse geschah, holt sich das
# Journal ueber seinen eigenen API-Import direkt bei der Boerse.
TC_API_URL=http://localhost:8080
TC_API_KEY=

# ── Boersen ─────────────────────────────────────────────────────────────
#
# Ein Handelsplan bringt seine Boerse mit. Diese Angabe gilt fuer Plaene
# ohne eigene Zuordnung. 'paper' handelt nichts, sondern rechnet gegen
# Kurse — der Uebungsbetrieb.
DEFAULT_EXCHANGE=paper

# Nur Boersen mit Zulassung im EWR (MiCA) zulassen. Steht das auf true,
# lehnt der Bot Plaene auf nicht zugelassenen Boersen ab und schreibt den
# Grund ins Ausfuehrungsprotokoll.
NUR_MICA_BOERSEN=true

# ── RIEGEL GEGEN ECHTEN HANDEL ──────────────────────────────────────────
#
# Steht das auf true, verlaesst KEIN Auftrag den Bot. Jede Boerse wird
# auf den Uebungsbroker umgeleitet — auch eine mit hinterlegten
# Zugangsdaten und auch dann, wenn ein Handelssignal von aussen
# ausdruecklich eine Boerse nennt.
#
# Der Riegel sitzt in createBroker(), der einzigen Stelle, an der ein
# Boersenzugang entsteht. Beim Start erscheint im Protokoll die Warnung
# "*** NUR UEBUNGSBETRIEB ***".
#
# Fuer die Einfahrphase eines neuen Signalgebers der richtige Ort.
NUR_UEBUNGSBETRIEB=false

# Startkapital des Uebungskontos. Hierauf rechnet der Bot die
# Signal-Groessen um. Kursquelle ist die oeffentliche Ticker-API von
# Phemex — dafuer sind keine Zugangsdaten noetig.
UEBUNGS_KAPITAL=10000
UEBUNGS_WAEHRUNG=USDT

# Zugangsdaten je Boerse. Schema: <BOERSE>_API_KEY / _API_SECRET /
# _PASSWORD / _TESTNET / _MARKET_TYPE. Nur ausfuellen, was gebraucht wird —
# eine Boerse ohne Schluessel gilt als nicht eingerichtet.
#
# Mit EWR-Zulassung:
#   BITPANDA_*      Bitpanda        (BaFin/FMA)          nur Kasse
#   KRAKEN_*        Kraken          (Irland/Luxemburg)   nur Kasse
#   KRAKENFUTURES_* Kraken Futures  (Irland/Luxemburg)   nur Termin
#   COINBASE_*      Coinbase        (Irland)             nur Kasse
#   BITSTAMP_*      Bitstamp        (Luxemburg)          nur Kasse
#   OKX_*           OKX Europa      (Malta)              Kasse + Termin
#   BYBIT_*         Bybit           (Bulgarien/NL)       Kasse + Termin
#   CRYPTOCOM_*     Crypto.com      (Malta)              Kasse + Termin
#
# Zulassung noch offen:
#   KUCOIN_*        KuCoin Futures                       nur Termin
#
# Ohne EWR-Zulassung (nur mit NUR_MICA_BOERSEN=false handelbar):
#   PHEMEX_*  BINANCE_*  BINGX_*  GATEIO_*
#
# Passphrase noetig bei: OKX, KuCoin, Crypto.com, Bitpanda.

# KRAKENFUTURES_API_KEY=
# KRAKENFUTURES_API_SECRET=
# KRAKENFUTURES_TESTNET=false

# OKX_API_KEY=
# OKX_API_SECRET=
# OKX_PASSWORD=
# OKX_MARKET_TYPE=futures

# ── Weboberflaeche ──────────────────────────────────────────────────────
WEB_UI_PASSWORD=
WEB_PORT=3300

# ── Abfrage-Takte (ms) ──────────────────────────────────────────────────
PLAN_POLL_INTERVAL=30000
PRICE_POLL_INTERVAL=2000
ORDER_CHECK_INTERVAL=3000

# ── Protokollierung: trace | debug | info | warn | error ────────────────
LOG_LEVEL=info

# ── Datenverzeichnis ────────────────────────────────────────────────────
DATA_DIR=./data

# ── Telegram-Benachrichtigungen (optional) ──────────────────────────────
# TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ============================================================
# Eingang fuer externe Handelssignale (TradingView u. ae.)
#
# Ausfuehrlich beschrieben in docs/TRADINGVIEW-SIGNALE.md — dort steht
# auch das Datenformat, das der Indikator schicken muss.
# ============================================================

# ── Zugang ──────────────────────────────────────────────────────────────
#
# Ohne Geheimnis nimmt der Webhook nichts an. Die Adresse ist oeffentlich
# erreichbar, denn TradingView kann sich nicht anmelden — das Geheimnis
# tritt an die Stelle des Passworts. Mindestens 24 Zeichen, zufaellig.
#
#   openssl rand -hex 32
#
# Adresse danach:  POST https://<host>/webhook/signal/<geheimnis>
# SIGNAL_WEBHOOK_SECRET=

# Statt des Geheimnisses im Pfad eine HMAC-SHA256-Signatur ueber den
# Rumpf verlangen (Kopfzeile X-Signature). Sicherer, weil die Adresse in
# Protokollen und Browserverlaeufen auftaucht, die Signatur aber nicht.
# TradingView selbst kann das nicht — fuer einen eigenen Signalgeber ist
# es der bessere Weg.
# SIGNAL_REQUIRE_SIGNATURE=false

# Wie alt ein Signal hoechstens sein darf, in Sekunden. Ein altes Signal
# bezieht sich auf einen Markt, den es so nicht mehr gibt.
# SIGNAL_MAX_AGE_SECONDS=300

# ── Umrechnung auf das eigene Kapital ───────────────────────────────────
#
# Das Signal ist auf ein vereinbartes Kapital ausgelegt. Der Bot rechnet
# die Groesse auf den tatsaechlichen Kontostand um.
#
# WICHTIG: Umgerechnet wird ausschliesslich die Groesse — also Margin und
# Positionsgroesse. Hebel, Stop-Loss, Take-Profits und Trailing bleiben
# unveraendert so, wie der Signalgeber sie bestimmt hat.
# SIGNAL_REFERENCE_CAPITAL=10000

# Duerfen Plaene aus Signalen sofort handeln?
#
# Voreingestellt nein: Der Plan wird angelegt und ist in der Oberflaeche
# sichtbar, wird aber erst nach Freigabe ausgefuehrt. Einen neuen
# Signalgeber sollte man erst eine Weile mitlaufen lassen.
# SIGNAL_AUTO_START=false

# ── Risikoprofil ────────────────────────────────────────────────────────
#
# Diese Grenzen wirken nur nach unten: Sie koennen eine Position
# verkleinern, nie vergroessern. Einzige Ausnahme ist SIGNAL_MULTIPLIER.
# Es gilt immer die schaerfste.

# Anteil des Kontostands, der fuer Signal-Handel bereitsteht.
# 1 = das ganze Konto, 0.5 = die Haelfte.
# SIGNAL_CAPITAL_FRACTION=1

# Bewusste Verstaerkung oder Daempfung gegenueber dem Signalgeber.
# 1 = massstabsgetreu, 0.5 = halb so gross, 2 = doppelt.
# SIGNAL_MULTIPLIER=1

# Hoechstverlust je Trade als Anteil des Kontostands, gemessen am
# Stop-Loss des Signals. 0.02 = 2 %. Greift nur, wenn das Signal einen
# Stop-Loss nennt. 0 schaltet die Grenze ab.
# SIGNAL_MAX_RISK_PER_TRADE_PCT=0.02

# Hoechste Margin je Trade als Anteil des Kontostands. 0.2 = 20 %.
# SIGNAL_MAX_MARGIN_PER_TRADE_PCT=0.2

# Anteil der freien Margin, der hoechstens gebunden werden darf. Der
# Rest bleibt fuer Nachschuss und Gebuehren.
# SIGNAL_USABLE_FREE_MARGIN_PCT=0.9

# Was tun, wenn eine Teil-Order nach der Umrechnung unter die
# Mindestgroesse der Boerse faellt?
#   drop   — die Teil-Order entfaellt, der Rest wird gehandelt
#   reject — das ganze Signal wird abgelehnt
# SIGNAL_BELOW_MINIMUM=drop

# Wieviel der geplanten Groesse nach allen Streichungen mindestens
# uebrig bleiben muss. 0.5 = die Haelfte, sonst wird abgelehnt.
# SIGNAL_MIN_REMAINING_FRACTION=0.5

# ── Kontostand ──────────────────────────────────────────────────────────
#
# Der Kontostand kommt von der Boerse. Gibt sie keine Auskunft, wird
# abgelehnt — ein Trade auf einer geratenen Kontogroesse ist schlimmer
# als kein Trade. Wer das anders will, schaltet den Ersatzwert frei.
# SIGNAL_ALLOW_FALLBACK=false
# SIGNAL_FALLBACK_EQUITY=0

# ── Freigabe wartender Plaene (Weg A) ───────────────────────────────────
#
# Wie lange eine eingegangene Freigabe gueltig bleibt, in Sekunden.
# SIGNAL_TRIGGER_TTL_SECONDS=300
